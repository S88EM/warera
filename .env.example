# WarEra API Key (формату wae_...)
WARERA_API_KEY=

# Налаштування Telegram сповіщень
# 1. Приватний бот сканера ринку (тільки для вас як власника)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Окремий бот снайпера битв (для вас та 25+ сокланівців)
TELEGRAM_SNIPER_BOT_TOKEN=

# Сесійні параметри WarEra Market
WARERA_COOKIE=
WARERA_X_VID=
WARERA_X_GR=
WARERA_EQUIPMENT_API_URL=https://api6.warera.io/trpc

# Параметри сканера спорядження
PRICING_MODE=live
EQUIPMENT_SCAN_INTERVAL=1
EQUIPMENT_MIN_DISCOUNT=5.0
EQUIPMENT_GOD_ROLL_THRESHOLD=80.0
EQUIPMENT_QUALITIES=mythic,legendary,epic,rare

# Веб-дашборд (Ingress / Локальний UI)
ENABLE_WEB_DASHBOARD=true
WEB_DASHBOARD_HOST=0.0.0.0
WEB_DASHBOARD_PORT=8080
# Опціональний токен для захисту мутуючих POST-ендпоінтів поза Home Assistant Ingress
DASHBOARD_API_TOKEN=

# Налаштування клану за замовчуванням (опціонально)
DEFAULT_CLAN_OWNER=
DEFAULT_MU_ID=
