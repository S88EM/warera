[Unit]
Description=WarEra Market Scanner & Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Замініть pi на вашого користувача на Raspberry Pi, якщо він інший
User=pi
WorkingDirectory=/home/pi/warera
ExecStart=/home/pi/warera/.venv/bin/python main.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
