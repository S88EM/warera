# WarEra API Key (якщо не вказано, зчитується автоматично з API_key.txt)
WARERA_API_KEY=

# Налаштування Telegram сповіщень
# 1. Приватний бот сканера ринку (тільки для вас)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Окремий бот снайпера битв (для вас та 25+ сокланівців)
TELEGRAM_SNIPER_BOT_TOKEN=

# Налаштування Discord сповіщень (Webhook URL каналу)
DISCORD_WEBHOOK_URL=

# --- Параметри сканера ресурсів (Commodities) ---
SCAN_INTERVAL_SECONDS=15
MIN_DISCOUNT_PERCENT=3.0
MIN_PROFIT_AMOUNT=1.0
ITEMS_TO_MONITOR=

# --- Параметри сканера зброї та речей (Weapons & Equipment) ---
WARERA_COOKIE=
WARERA_X_VID=aa795e6d3c4929b380ab728c29363a32
WARERA_X_GR=ANGLE (Intel, Intel(R) Iris(R) Xe Graphics (0x00009A49) Direct3D11 vs_5_0 ps_5_0, D3D11)
WARERA_EQUIPMENT_API_URL=https://api6.warera.io/trpc

EQUIPMENT_SCAN_INTERVAL=20
EQUIPMENT_MIN_DISCOUNT=5.0
EQUIPMENT_GOD_ROLL_THRESHOLD=80.0
EQUIPMENT_TO_MONITOR=jet,tank,sniper,rifle,helmet6,helmet5,helmet4,chest6,chest5,chest4,boots6,boots5,boots4,pants6,pants5,pants4,gloves6,gloves5,gloves4
